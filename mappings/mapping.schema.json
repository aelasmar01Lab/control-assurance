{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aelasmar01Lab/control-assurance/mappings/mapping.schema.json",
  "title": "Framework mappings",
  "description": "Every tie between a control and a requirement of one framework version. One file per framework, at mappings/<framework>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "version", "mappings"],
  "properties": {
    "framework": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "requirement", "strength", "rationale", "basis", "review"],
        "properties": {
          "control": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "strength": { "enum": ["direct", "partial", "supporting"] },
          "rationale": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string" },
          "basis": { "enum": ["own_analysis", "published_crosswalk", "derived"] },
          "basis_source": { "type": "string" },
          "reviewer_note": { "type": "string" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "drafted_by", "reviewed_by", "reviewed_on", "content_sha256"],
            "properties": {
              "status": { "enum": ["draft", "reviewed"] },
              "drafted_by": { "type": "string", "minLength": 1 },
              "reviewed_by": { "type": "string" },
              "reviewed_on": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
              "content_sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" }
            }
          }
        }
      }
    }
  }
}
