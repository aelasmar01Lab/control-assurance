{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aelasmar01Lab/control-assurance/tracking/tracking.schema.json",
  "title": "Tracking entries",
  "description": "The requirements of one framework version that no control covers, and how one organization tracks each. One file per organization and framework, at tracking/<organization>/<framework>.yaml. An entry with status not_assessed says only that nobody has looked at the requirement yet: it carries nothing else, has no review block and is not signed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "version", "entries"],
  "properties": {
    "framework": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "status"],
        "if": { "properties": { "status": { "const": "not_assessed" } } },
        "then": {
          "properties": { "requirement": true, "status": true },
          "additionalProperties": false
        },
        "else": { "required": ["owner_role", "applicability", "evidence_expectation", "rationale", "review"] },
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["manual", "not_implemented", "out_of_scope", "not_assessed"] },
          "owner_role": { "type": "string", "minLength": 1 },
          "applicability": { "type": "string", "minLength": 1 },
          "evidence_expectation": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "reviewer_note": { "type": "string" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "drafted_by", "reviewed_by", "reviewed_on", "content_sha256"],
            "properties": {
              "status": { "enum": ["draft", "reviewed"] },
              "drafted_by": { "type": "string", "minLength": 1 },
              "reviewed_by": { "type": "string" },
              "reviewed_on": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
              "content_sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" }
            }
          }
        }
      }
    }
  }
}
