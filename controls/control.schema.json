{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aelasmar01Lab/control-assurance/controls/control.schema.json",
  "title": "Control",
  "description": "One internal control: something the organization does to reduce a risk. One file per control, at controls/<domain>/<key>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "title", "statement", "risk", "owner_role", "type", "checks", "evidence_expectation", "applies_to_lab", "review"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "owner_role": { "type": "string", "minLength": 1 },
    "type": { "enum": ["automated", "manual", "policy", "hybrid"] },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "manual_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "validity_months"],
      "properties": {
        "expectation": { "type": "string", "minLength": 1 },
        "validity_months": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence_expectation": { "type": "string", "minLength": 1 },
    "freshness_hours": { "type": "integer", "minimum": 0 },
    "applies_to_lab": { "enum": ["yes", "no", "partly"] },
    "applies_reason": { "type": "string" },
    "reviewer_note": { "type": "string" },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "drafted_by", "reviewed_by", "reviewed_on", "content_sha256"],
      "properties": {
        "status": { "enum": ["draft", "reviewed"] },
        "drafted_by": { "type": "string", "minLength": 1 },
        "reviewed_by": { "type": "string" },
        "reviewed_on": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
        "content_sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" }
      }
    }
  }
}
