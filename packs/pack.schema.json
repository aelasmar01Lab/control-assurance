{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aelasmar01Lab/control-assurance/packs/pack.schema.json",
  "title": "Framework pack",
  "description": "One version of one framework: where its text came from and the requirements it contains.",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "requirements"],
  "properties": {
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "version", "license", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path", "retrieved", "sha256"],
          "properties": {
            "repository": { "type": "string", "pattern": "^https://" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": { "type": "string", "minLength": 1 },
            "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "title", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "group": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
