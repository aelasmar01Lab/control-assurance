# Copy to .env for local development. Never commit .env.
POSTGRES_USER=cca
POSTGRES_PASSWORD=cca_local_only
POSTGRES_DB=cca
POSTGRES_PORT=5433
DATABASE_URL=postgres://cca:cca_local_only@127.0.0.1:5433/cca?sslmode=disable

# Evidence payloads are written here, keyed by SHA-256.
CCA_EVIDENCE_DIR=data/evidence

# Repositories to collect from when none are named on the command line.
CCA_GITHUB_REPOS=aelasmar01Lab/cca-lab-service,aelasmar01Lab/cca-lab-library

# Optional. When unset, the GitHub CLI's current login is used (gh auth token).
# GITHUB_TOKEN=

# The user CLI commands act as. Its role decides what a command may do, and
# its name is written to the decision log. Create the lab users with
# `cca users seed`.
CCA_USER=operator
